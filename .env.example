# ==============================================================================
# SCOUT MCP Server - Environment Variables Template
# ==============================================================================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control (it's in .gitignore)
#
# API Key Rotation: Every 90 days (add calendar reminder)
# ==============================================================================

# ------------------------------------------------------------------------------
# AI Provider API Keys
# ------------------------------------------------------------------------------

# Google Gemini (https://makersuite.google.com/app/apikey)
GEMINI_API_KEY=AIza...

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=sk-proj-...

# Anthropic Claude (https://console.anthropic.com/settings/keys)
ANTHROPIC_API_KEY=sk-ant-...

# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-...

# Grok / X.AI (https://console.x.ai/)
GROK_API_KEY=xai-...

# ------------------------------------------------------------------------------
# Infrastructure
# ------------------------------------------------------------------------------

# Redis Connection
# Local: redis://localhost:6379
# Upstash: redis://default:<password>@<host>:<port>
REDIS_URL=redis://localhost:6379

# Redis Password (if required)
REDIS_PASSWORD=

# ------------------------------------------------------------------------------
# External Integrations (Optional)
# ------------------------------------------------------------------------------

# Notion Integration (https://www.notion.so/my-integrations)
NOTION_TOKEN=secret_...
NOTION_RESEARCH_DB_ID=

# Tavily Search API (https://tavily.com/)
TAVILY_API_KEY=tvly-...

# ------------------------------------------------------------------------------
# Application Configuration
# ------------------------------------------------------------------------------

# Environment: development, staging, production
SCOUT_ENV=development

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Enable debug mode (verbose logging, payloads in logs)
DEBUG=false

# Maximum concurrent tool executions
MAX_CONCURRENT_TOOLS=100

# Default cost alert threshold (USD per day)
COST_ALERT_THRESHOLD=50.0

# ------------------------------------------------------------------------------
# Security & Rate Limiting
# ------------------------------------------------------------------------------

# Rate limiting
MAX_REQUESTS_PER_HOUR_PER_USER=100
MAX_REQUESTS_PER_DAY_GLOBAL=1000

# Request timeout (seconds)
REQUEST_TIMEOUT=300

# Maximum input size (bytes)
MAX_INPUT_SIZE=102400

# ------------------------------------------------------------------------------
# Cache Configuration
# ------------------------------------------------------------------------------

# Cache TTL for identical requests (seconds)
CACHE_TTL_SECONDS=3600

# Enable/disable caching
ENABLE_CACHE=true

# ------------------------------------------------------------------------------
# Observability (Optional)
# ------------------------------------------------------------------------------

# OpenTelemetry Collector Endpoint
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Enable metrics
ENABLE_METRICS=true

# Enable tracing
ENABLE_TRACING=false

# ------------------------------------------------------------------------------
# Development Helpers
# ------------------------------------------------------------------------------

# Bypass API key validation (for testing with mocks)
BYPASS_API_KEY_VALIDATION=false

# Mock providers (for integration tests)
MOCK_PROVIDERS=false
